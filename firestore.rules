// FIFA Survivor — Firestore Security Rules for the "leaderboard" collection.
//
// This file is NOT picked up automatically. Firestore rules live on the server, not in
// this repo: paste it into Firebase Console -> Firestore Database -> Rules -> Publish
// (or `firebase deploy --only firestore:rules`). Deploying to Vercel does NOT apply it.
// After publishing, use the "Rules Playground" tab to confirm a normal save still passes.
//
// WHAT THESE RULES CAN AND CAN'T DO
//   They stop: arbitrary fields, wrong types, absurd scores (> MAX_SCORE), editing
//   someone's name/tag, lowering a score, deleting, junk document IDs, and back-dated
//   timestamps.
//   They can NOT stop: someone calling the SDK from devtools with a fake-but-under-cap
//   score (e.g. 4900). Rules can't see how the game was played. Keep MAX_SCORE just above
//   the best score a human can really reach (play a few perfect runs and check), because
//   that number is the real ceiling on cheating. Full protection needs a server-side
//   submit endpoint (see README).
//
// MAX_SCORE lives in one place below. Edit the number in isValidLeaderboardDoc().

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared shape check for create and update.
    // - hasOnly: no extra fields can be smuggled in.
    // - name: 1-12 chars, no newlines and no [ ] (Kaboom reads [style]text[/style] markup in
    //   text, which would let a name hide/alter what the scoreboard shows).
    // - name_lowercase must really be name.lower(), so the duplicate-name lookup can't be dodged.
    // - tag: "#" + 2-3 digits, as generated by the game.
    // - score: a whole number 0..MAX_SCORE.
    // - timestamp: must be the server's own time (the game writes serverTimestamp()),
    //   so nobody can fake "recent" or "old" entries.
    function isValidLeaderboardDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'tag', 'name_lowercase', 'score', 'timestamp']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 12 &&
        !d.name.matches('.*[\\n\\r\\[\\]].*') &&
        d.name_lowercase == d.name.lower() &&
        d.tag is string && d.tag.matches('^#[0-9]{2,3}$') &&
        d.score is number && d.score >= 0 && d.score <= 5000 && d.score == math.floor(d.score) &&
        d.timestamp == request.time;
    }

    match /leaderboard/{docId} {

      // Anyone can read the leaderboard (Top 5 + rank counts).
      allow read: if true;

      // First time this player identity is written. The document ID must be exactly what
      // the game builds (player_<slug>_<tag digits>) so one cannot mass-produce random IDs
      // or write into another player's slot with a mismatched name/tag.
      allow create: if isValidLeaderboardDoc() &&
        docId.matches('^player_[a-z0-9_]{1,24}_[0-9]{2,3}$') &&
        docId.matches('.*_' + request.resource.data.tag.split('#')[1] + '$');

      // A retry re-writes the same doc: only if the score goes UP and name/tag are unchanged.
      allow update: if isValidLeaderboardDoc() &&
        request.resource.data.score > resource.data.score &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.tag == resource.data.tag;

      allow delete: if false;
    }
  }
}
