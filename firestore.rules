// FIFA Survivor — recommended Firestore Security Rules for the "leaderboard" collection.
//
// This file is NOT picked up automatically. Firestore rules live on the server, not in
// this repo, so you need to paste this into:
//   Firebase Console → your project → Firestore Database → Rules → publish
// (or deploy via the Firebase CLI with `firebase deploy --only firestore:rules` if you
// have a firebase.json wired up.)
//
// Right now the client can write ANY document with ANY score straight to Firestore -
// config.js's saveScoreToLeaderboard() has a client-side plausibility check, but that
// only stops accidental/naive bad values, not someone calling the Firestore SDK directly
// from devtools. These rules push the real validation onto the server, where it can't be
// bypassed by editing client code.
//
// One doc per player identity now (see buildPlayerDocId in config.js), re-written on
// every match via set() rather than a new doc per match via add() - so both "create"
// (first time this player appears) and "update" (every retry after) need rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared shape check used by both create and update: every field present, no extra
    // fields snuck in (hasOnly, not just hasAll — hasAll alone would let a client add
    // arbitrary bonus fields to the doc), and each field the right type/shape.
    // - name: 1-12 chars, no newlines (so it can never break out of the single-line
    //   scoreboard row it's rendered into).
    // - name_lowercase: must actually BE name lowercased, not just "a string" —
    //   otherwise someone could set name="Bob" / name_lowercase="somethingelse" to
    //   dodge the generateUniqueTag() duplicate-name lookup, or collide with someone
    //   else's identity.
    // - tag: must match the "#" + 2-3 digits format the game itself generates (e.g.
    //   "#07"), so a client can't write tag="#EXPLOIT" or an empty string.
    // NOTE: functions can only be declared inside this service/match block, never
    // above `rules_version` or outside `service cloud.firestore { ... }` — that's why
    // this moved down here.
    function isValidLeaderboardDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'tag', 'name_lowercase', 'score', 'timestamp']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 12 &&
        !d.name.matches('.*[\\n\\r].*') &&
        d.name_lowercase == d.name.lower() &&
        d.tag is string && d.tag.matches('^#[0-9]{2,3}$') &&
        d.score is number && d.score >= 0 && d.score <= 5000;
    }

    match /leaderboard/{docId} {

      // Anyone can read the leaderboard (needed for the Top 5 display).
      allow read: if true;

      // First time this player identity is written.
      // Tune MAX_SCORE (5000, referenced inside isValidLeaderboardDoc) to whatever a
      // genuinely exceptional (but still humanly possible) run could produce, so real
      // high scores aren't blocked.
      allow create: if isValidLeaderboardDoc();

      // A "Try Again" retry re-writes the same doc - only allow it through if the new
      // score is actually higher than what's already there, and the identity fields
      // (name/tag) aren't being changed out from under the doc.
      allow update: if isValidLeaderboardDoc() &&
        request.resource.data.score > resource.data.score &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.tag == resource.data.tag;

      allow delete: if false;
    }
  }
}
