// FIFA Survivor: Firestore Security Rules.
//
// This file is NOT picked up automatically. Firestore rules live on the server, not in
// this repo: paste it into Firebase Console -> Firestore Database -> Rules -> Publish
// (or `firebase deploy --only firestore:rules`). Deploying to Vercel does NOT apply it.
//
// HOW WRITES WORK NOW
//   The browser may only READ the leaderboard. Every write goes through the Vercel API
//   (api/submit.js), which uses the Admin SDK, bypasses these rules, and checks the score
//   against a server-side run clock before saving. The rules below therefore deny all
//   client writes, so devtools tricks like calling the Firestore SDK directly with a fake
//   score no longer work.
//
//   The API stores its own bookkeeping in two more collections ("runs" and
//   "tag_reservations"). They are not readable or writable from the browser at all.
//
// WHAT THIS DOES NOT STOP
//   Someone who really plays for the full time can still get the maximum plausible score
//   for that time (see MAX_SCORE and MAX_SCORE_PER_SECOND in api/_lib.js). Keep MAX_SCORE
//   just above the best score a human can reach.
//
// After publishing, use the Rules Playground tab: a read of leaderboard/anything should
// pass, and any create/update/delete should be denied.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read the leaderboard (Top 5 and the rank counts). Nobody can write.
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else (runs, tag_reservations, anything added later) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
